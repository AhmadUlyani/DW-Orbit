# Salin menjadi .env lalu ganti semua nilai CHANGE_ME. Jangan commit file .env.
# PostgreSQL superuser (hanya untuk inisialisasi & DBA)
POSTGRES_PASSWORD=CHANGE_ME
# Airflow metadata DB & admin UI
AIRFLOW_DB_PASSWORD=CHANGE_ME
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME
AIRFLOW_FERNET_KEY=CHANGE_ME_base64_32byte_key
# Role Data Warehouse (RBAC)
DW_ETL_USER=etl_writer
DW_ETL_PASSWORD=CHANGE_ME
DW_BI_USER=bi_reader
DW_BI_PASSWORD=CHANGE_ME
DW_ANALYST_USER=analyst_ro
DW_ANALYST_PASSWORD=CHANGE_ME
# MinIO (Data Lake)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_PIPELINE_USER=orbit-pipeline
MINIO_PIPELINE_PASSWORD=CHANGE_ME
# Launch Library 2 API
LL2_BASE_URL=https://ll.thespacedevs.com/2.3.0
LL2_RATE_LIMIT_PER_HOUR=15
# opsional: token Patreon The Space Devs untuk kuota lebih tinggi (kosongkan jika tidak ada)
LL2_API_TOKEN=
# Alerting (opsional). Jika kosong, alert hanya ditulis ke meta.alert & log
# Notifikasi dikirim saat: task gagal final (retry habis), quality gate BLOCK, dan DAG run gagal.
# Discord: Server Settings > Integrations > Webhooks > New Webhook > pilih channel > Copy Webhook URL.
# Bentuk URL: https://discord.com/api/webhooks/<WEBHOOK_ID>/<WEBHOOK_TOKEN>
# URL webhook bersifat rahasia (siapa pun yang punya URL bisa mengirim pesan ke channel).
ALERT_WEBHOOK_URL=
